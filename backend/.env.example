# Gemini Developer API key — https://aistudio.google.com/apikey
# Server-side only. Never expose this to the browser.
GEMINI_API_KEY=

# Comma-separated origins allowed to call /api/chat.
# Local Svelte dev/preview servers plus the deployed portfolio.
# Add any custom domain here too once it points at the site.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://akshatgg.vercel.app

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
RATE_LIMIT_PER_MINUTE=10
