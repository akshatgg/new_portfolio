# ── Gemini ───────────────────────────────────────────────────────────────────
# Key from https://aistudio.google.com/apikey. Server-side only.
GEMINI_API_KEY=

# ── Atlassian (live Confluence tools) ────────────────────────────────────────
# Plain API token — no Marketplace/Forge/OAuth app needed.
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
# Without these the agent falls back to the static data/about-me.md snapshot.
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# ── GitHub (code tools) ───────────────────────────────────────────────────────
# Read-only token for the akshatgg account. Use a fine-grained token with
# "Contents: read" + "Metadata: read" only. Public repos work without it, but
# under a 60/hour limit and with no code search.
GITHUB_TOKEN=
# Private repos are hidden from the chat unless named here (comma-separated),
# or `*` for all of them. Visitors can read anything listed — choose carefully.
GITHUB_PRIVATE_REPOS=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call /api/chat.
# Without this, only localhost dev servers are permitted.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Optional overrides ───────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.8-flash
RATE_LIMIT_PER_MINUTE=20
CONFLUENCE_SITE=akshatg9636.atlassian.net
CONFLUENCE_SPACE_KEY=~7120200844476cfa4946c3b51daf1ada4a318d
CONFLUENCE_CACHE_TTL_MS=900000
GITHUB_OWNER=akshatgg
GITHUB_CACHE_TTL_MS=900000
